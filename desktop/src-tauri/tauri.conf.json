{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HV Song Tagger",
  "version": "0.1.0",
  "identifier": "org.hvtagger.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node build-frontend.mjs",
    "beforeBuildCommand": "node build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "H↔V Song Tagger",
        "width": 1100,
        "height": 840,
        "minWidth": 420,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Tag Planning Center worship songs with a 1-5 Horizontal-Vertical direction",
    "copyright": "MIT License",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
